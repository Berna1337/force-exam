{
  "name": "force-exam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run desktop",
    "lint": "next lint",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:build": "npm run build && electron-builder --publish never",
    "desktop:win": "npm run build && electron-builder --win --publish never",
    "desktop:mac": "npm run build && electron-builder --mac --publish never",
    "desktop:linux": "npm run build && electron-builder --linux --publish never",
    "postinstall": "install-electron",
    "desktop:test": "npm run build && electron desktop/smoke.cjs",
    "test": "node tests/study.test.mjs && node tests/compare.test.mjs && node tests/run.test.mjs && node tests/images.test.mjs && node tests/organization.test.mjs && node tests/collections.test.mjs && node tests/exam-git.test.cjs"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@types/node": "20.10.0",
    "@types/react": "18.2.39",
    "@types/react-dom": "18.2.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "8.54.0",
    "eslint-config-next": "14.0.3",
    "framer-motion": "^11.0.3",
    "next": "14.1.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "5.3.2"
  },
  "description": "Offline practice exams for Windows, macOS, and Linux",
  "main": "desktop/entry.cjs",
  "dependencies": {
    "isomorphic-git": "^1.44.5"
  }
}
